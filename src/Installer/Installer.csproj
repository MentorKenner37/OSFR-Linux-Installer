<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Resources/launcher-linux-x64.zip')">
    <EmbeddedResource Include="Resources/launcher-linux-x64.zip" LogicalName="OSFR.Linux.Installer.Payload" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Resources/icon.png')">
    <AvaloniaResource Include="Resources/icon.png" />
    <EmbeddedResource Include="Resources/icon.png" LogicalName="OSFR.Linux.Installer.Icon" />
  </ItemGroup>
</Project>
