<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:OSFR.Linux.Installer.Services"
        x:Class="OSFR.Linux.Installer.MainWindow"
        Title="OSFR Linux Installer"
        Width="1180" Height="760" MinWidth="980" MinHeight="700"
        Background="#101010">

  <Grid ColumnDefinitions="310,*">
    <Border Grid.Column="0" Background="#121212" BorderBrush="#2B2B2B" BorderThickness="0,0,1,0" Padding="24">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="18">
        <StackPanel Grid.Row="0" Spacing="2">
          <TextBlock Text="OSFR" FontSize="42" FontWeight="Bold" Foreground="#F4F4F4" />
          <TextBlock Text="LINUX INSTALLER" FontSize="15" FontWeight="Bold" Foreground="#D53B3B" LetterSpacing="1.5" />
        </StackPanel>

        <Border Grid.Row="1" Background="#171717" BorderBrush="#313131" BorderThickness="1" CornerRadius="8" Padding="18">
          <StackPanel Spacing="14">
            <TextBlock Text="System Readiness" FontSize="18" FontWeight="SemiBold" Foreground="#E64A4A" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="●" Foreground="#45D483" FontSize="16" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Operating System" Foreground="#F0F0F0" FontWeight="SemiBold" />
                <TextBlock x:Name="LinuxStatus" FontSize="12" Foreground="#A0A0A0" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="●" Foreground="#45D483" FontSize="16" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Processor" Foreground="#F0F0F0" FontWeight="SemiBold" />
                <TextBlock x:Name="CpuStatus" FontSize="12" Foreground="#A0A0A0" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="●" Foreground="#45D483" FontSize="16" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Steam" Foreground="#F0F0F0" FontWeight="SemiBold" />
                <TextBlock x:Name="SteamStatus" FontSize="12" Foreground="#A0A0A0" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="●" Foreground="#45D483" FontSize="16" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Proton" Foreground="#F0F0F0" FontWeight="SemiBold" />
                <TextBlock x:Name="ProtonStatus" FontSize="12" Foreground="#A0A0A0" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#171717" BorderBrush="#313131" BorderThickness="1" CornerRadius="8" Padding="18">
          <StackPanel Spacing="8">
            <TextBlock Text="About" FontSize="17" FontWeight="SemiBold" Foreground="#E64A4A" />
            <TextBlock Text="Installs and configures Open Source Free Realms on Linux using Steam Proton." TextWrapping="Wrap" Foreground="#B6B6B6" FontSize="12" LineHeight="18" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Spacing="7">
          <TextBlock x:Name="HeroStatus" Text="Checking system..." FontWeight="SemiBold" FontSize="12" Foreground="#45D483" />
          <TextBlock Text="Steam and Proton are detected only. They are not modified by this installer." TextWrapping="Wrap" Foreground="#707070" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="#141414" BorderBrush="#2B2B2B" BorderThickness="0,0,0,1" Padding="28,22">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="OSFR Linux Installer" FontSize="25" FontWeight="SemiBold" Foreground="#F5F5F5" />
            <TextBlock Text="Configure Open Source Free Realms for Steam Proton" Foreground="#8D8D8D" FontSize="12" />
          </StackPanel>
          <Border Grid.Column="1" Background="#1C1C1C" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="15" Padding="12,6" VerticalAlignment="Center">
            <TextBlock Text="ALPHA" Foreground="#E64A4A" FontWeight="Bold" FontSize="11" />
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,30" Spacing="22">
          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="7" HorizontalAlignment="Stretch">
              <Border Background="#C93232" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" /></Border>
              <TextBlock Text="Welcome" HorizontalAlignment="Center" Foreground="#E64A4A" FontWeight="SemiBold" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="7" HorizontalAlignment="Stretch">
              <Border Background="#232323" BorderBrush="#414141" BorderThickness="1" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A5A5A5" /></Border>
              <TextBlock Text="Location" HorizontalAlignment="Center" Foreground="#9A9A9A" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="7" HorizontalAlignment="Stretch">
              <Border Background="#232323" BorderBrush="#414141" BorderThickness="1" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A5A5A5" /></Border>
              <TextBlock Text="Proton" HorizontalAlignment="Center" Foreground="#9A9A9A" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="3" Spacing="7" HorizontalAlignment="Stretch">
              <Border Background="#232323" BorderBrush="#414141" BorderThickness="1" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A5A5A5" /></Border>
              <TextBlock Text="Summary" HorizontalAlignment="Center" Foreground="#9A9A9A" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="4" Spacing="7" HorizontalAlignment="Stretch">
              <Border Background="#232323" BorderBrush="#414141" BorderThickness="1" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A5A5A5" /></Border>
              <TextBlock Text="Install" HorizontalAlignment="Center" Foreground="#9A9A9A" FontSize="12" />
            </StackPanel>
          </Grid>

          <Border BorderBrush="#292929" BorderThickness="0,1,0,0" />

          <StackPanel Spacing="5">
            <TextBlock Text="Welcome to OSFR Linux Installer" FontSize="25" FontWeight="SemiBold" Foreground="#F4F4F4" />
            <TextBlock Text="Choose where OSFR should be installed and which detected Proton version should run Free Realms." Foreground="#B1B1B1" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>

          <Border Background="#151515" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel Spacing="18">
              <StackPanel Spacing="7">
                <TextBlock Text="Installation Directory" Foreground="#E64A4A" FontWeight="SemiBold" FontSize="15" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox x:Name="InstallPathBox" TextChanged="InstallPathChanged" />
                  <Button Grid.Column="1" Content="Browse..." Click="BrowseClicked" MinWidth="105" />
                </Grid>
                <TextBlock x:Name="InstallPathStatus" FontSize="11" Foreground="#45D483" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="7">
                <TextBlock Text="Proton Version" Foreground="#E64A4A" FontWeight="SemiBold" FontSize="15" />
                <ComboBox x:Name="ProtonComboBox" SelectionChanged="ProtonSelectionChanged">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:ProtonCandidate">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="The recommended detected build is selected automatically. You can choose another detected version." Foreground="#777777" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="Installation Progress" Foreground="#E64A4A" FontWeight="SemiBold" FontSize="15" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="StatusText" Text="Ready" Foreground="#B6B6B6" FontSize="12" />
                  <TextBlock x:Name="ProgressText" Grid.Column="1" Text="Ready" Foreground="#E64A4A" FontWeight="SemiBold" FontSize="12" />
                </Grid>
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Height="9" />
                <TextBlock x:Name="DetailText" Foreground="#7F7F7F" TextWrapping="Wrap" FontSize="11" MinHeight="18" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="#151515" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel Spacing="8">
              <TextBlock Text="Installation Options" Foreground="#E64A4A" FontWeight="SemiBold" FontSize="14" />
              <CheckBox x:Name="CloseAfterInstallCheck" Content="Close installer after a successful installation" IsChecked="True" />
              <TextBlock Text="Installer logs are stored separately under ~/.local/state/OSFR-Linux so they do not interfere with the installation directory." Foreground="#737373" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,2,0,0">
            <TextBlock Grid.Column="0" Text="Ready when you are." Foreground="#666666" VerticalAlignment="Center" FontSize="11" />
            <Button Grid.Column="1" Classes="ghost" Content="Close" Click="CloseClicked" MinWidth="105" />
            <Button x:Name="ActionButton" Grid.Column="2" Classes="primary" Content="INSTALL" Click="ActionClicked" MinWidth="145" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
