<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OSFR.Linux.Installer.MainWindow"
        Title="Open Source Free Realms - Linux Installer"
        Width="1040" Height="780" MinWidth="860" MinHeight="680"
        Background="#0A0F14">

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="#0D141B" BorderBrush="#1F2A34" BorderThickness="0,0,0,1" Padding="34,22">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="OPEN SOURCE FREE REALMS" FontSize="13" FontWeight="Bold" Foreground="#4EA8DE" />
          <TextBlock Text="Linux Installer" FontSize="30" FontWeight="SemiBold" Foreground="#F5F7F9" />
          <TextBlock Text="Installs the OSFR launcher and configures a dedicated Proton prefix." FontSize="14" Foreground="#8795A3" />
        </StackPanel>
        <Border Grid.Column="1" Background="#13202A" BorderBrush="#294459" BorderThickness="1" CornerRadius="18" Padding="14,8" VerticalAlignment="Top">
          <TextBlock x:Name="HeroStatus" Text="Checking system..." Foreground="#62C8A0" FontWeight="SemiBold" FontSize="12" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="34" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18">
        <Border Grid.Row="0" Background="#0F161D" BorderBrush="#202C36" BorderThickness="1" CornerRadius="14" Padding="22">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="System readiness" FontSize="18" FontWeight="SemiBold" Foreground="#F3F6F8" />
                <TextBlock Text="Checks Linux, x86_64, Steam, and Proton before installation." FontSize="13" Foreground="#7E8C99" Margin="0,3,0,0" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="SYSTEM CHECK" Foreground="#586A79" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
              <Border Grid.Row="0" Grid.Column="0" Background="#111A22" BorderBrush="#202D37" BorderThickness="1" CornerRadius="10" Padding="15">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Width="28" Height="28" CornerRadius="7" Background="#172A35"><TextBlock Text="L" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#57B8E6" FontWeight="Bold" /></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Linux" Foreground="#EEF2F5" FontWeight="SemiBold"/><TextBlock Text="Operating system" FontSize="11" Foreground="#72808C"/></StackPanel>
                  <TextBlock x:Name="LinuxStatus" Grid.Column="2" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Grid.Row="0" Grid.Column="1" Background="#111A22" BorderBrush="#202D37" BorderThickness="1" CornerRadius="10" Padding="15">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Width="28" Height="28" CornerRadius="7" Background="#172A35"><TextBlock Text="64" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#57B8E6" FontSize="11" FontWeight="Bold" /></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="x86_64" Foreground="#EEF2F5" FontWeight="SemiBold"/><TextBlock Text="Processor architecture" FontSize="11" Foreground="#72808C"/></StackPanel>
                  <TextBlock x:Name="CpuStatus" Grid.Column="2" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Grid.Row="1" Grid.Column="0" Background="#111A22" BorderBrush="#202D37" BorderThickness="1" CornerRadius="10" Padding="15">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Width="28" Height="28" CornerRadius="7" Background="#172A35"><TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#57B8E6" FontWeight="Bold" /></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Steam" Foreground="#EEF2F5" FontWeight="SemiBold"/><TextBlock Text="Client installation" FontSize="11" Foreground="#72808C"/></StackPanel>
                  <TextBlock x:Name="SteamStatus" Grid.Column="2" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Background="#111A22" BorderBrush="#202D37" BorderThickness="1" CornerRadius="10" Padding="15">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Width="28" Height="28" CornerRadius="7" Background="#172A35"><TextBlock Text="P" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#57B8E6" FontWeight="Bold" /></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Proton" Foreground="#EEF2F5" FontWeight="SemiBold"/><TextBlock Text="Compatibility runtime" FontSize="11" Foreground="#72808C"/></StackPanel>
                  <TextBlock x:Name="ProtonStatus" Grid.Column="2" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>

            <StackPanel Spacing="6">
              <TextBlock Text="Proton version" FontSize="13" FontWeight="SemiBold" Foreground="#EEF2F5" />
              <ComboBox x:Name="ProtonComboBox" SelectionChanged="ProtonSelectionChanged" MinHeight="38">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="The recommended detected version is selected automatically. You can override it before installing." FontSize="11" Foreground="#72808C" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#0F161D" BorderBrush="#202C36" BorderThickness="1" CornerRadius="14" Padding="22">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel Spacing="8">
              <TextBlock Text="Installation location" FontSize="17" FontWeight="SemiBold" Foreground="#F3F6F8" />
              <TextBlock Text="Choose where the launcher and dedicated Proton prefix will be stored." FontSize="12" Foreground="#7E8C99" />
              <TextBox x:Name="InstallPathBox" Margin="0,4,0,0" TextChanged="InstallPathChanged" />
              <TextBlock x:Name="InstallPathStatus" FontSize="11" Foreground="#62C8A0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Browse" Click="BrowseClicked" VerticalAlignment="Bottom" MinWidth="105" />
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0F161D" BorderBrush="#202C36" BorderThickness="1" CornerRadius="14" Padding="22">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Installation progress" FontSize="17" FontWeight="SemiBold" Foreground="#F3F6F8" />
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Foreground="#82909D" Margin="0,3,0,0" />
              </StackPanel>
              <TextBlock x:Name="ProgressText" Grid.Column="1" Text="Ready" Foreground="#57B8E6" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Height="10" Margin="0,3,0,0" />
            <TextBlock x:Name="DetailText" Foreground="#74818D" TextWrapping="Wrap" FontSize="12" MinHeight="18" />
            <TextBlock Text="Installer diagnostics are written to ~/.local/share/OSFR-Linux/installer.log" Foreground="#576573" FontSize="11" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,8">
          <Button x:Name="ActionButton" Classes="primary" Grid.Column="0" Content="INSTALL" Click="ActionClicked" MinWidth="150" />
          <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Spacing="5">
            <CheckBox x:Name="CloseAfterInstallCheck" Content="Close installer after a successful installation" IsChecked="True" Foreground="#A9B5C0" FontSize="12" />
            <TextBlock Text="Does not install or modify Steam or Proton." Foreground="#576573" FontSize="11" />
          </StackPanel>
          <Button Classes="ghost" Grid.Column="2" Content="Close" Click="CloseClicked" MinWidth="105" />
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
