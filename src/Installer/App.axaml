<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OSFR.Linux.Installer.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#111821" />
      <Setter Property="Foreground" Value="#F2F5F7" />
      <Setter Property="BorderBrush" Value="#2B3744" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#415264" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#4EA8DE" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#18222D" />
      <Setter Property="Foreground" Value="#E8EDF2" />
      <Setter Property="BorderBrush" Value="#2C3946" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#223140" />
      <Setter Property="BorderBrush" Value="#465C70" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2678A8" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#3294C9" />
      <Setter Property="Padding" Value="28,12" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#2D8CC1" />
      <Setter Property="BorderBrush" Value="#5BB6E4" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#303B47" />
      <Setter Property="Foreground" Value="#AEB8C2" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Background" Value="#10161D" />
      <Setter Property="Foreground" Value="#3AA7D8" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
  </Application.Styles>
</Application>
