<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OSFR.Linux.Installer.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
      <Setter Property="Background" Value="#101010" />
      <Setter Property="Foreground" Value="#F3F3F3" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="Foreground" Value="#F3F3F3" />
      <Setter Property="BorderBrush" Value="#383838" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="13,10" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#515151" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#42B86B" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="Foreground" Value="#F3F3F3" />
      <Setter Property="BorderBrush" Value="#383838" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#202020" />
      <Setter Property="Foreground" Value="#EEEEEE" />
      <Setter Property="BorderBrush" Value="#3B3B3B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#2A2A2A" />
      <Setter Property="BorderBrush" Value="#5A5A5A" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2F9E5A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#49BF72" />
      <Setter Property="Padding" Value="28,12" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#38B866" />
      <Setter Property="BorderBrush" Value="#62D487" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#191919" />
      <Setter Property="BorderBrush" Value="#373737" />
      <Setter Property="Foreground" Value="#BDBDBD" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="Foreground" Value="#42B86B" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#D8D8D8" />
    </Style>
  </Application.Styles>
</Application>
